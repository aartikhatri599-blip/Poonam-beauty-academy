# Copy this file to .env and fill in the values. Never commit .env.

# NeonDB → your project → Connection details → "Pooled connection" string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Any long random string (keep it secret, don't change it once live)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public address of the site (no trailing slash). Local: http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Resend → API Keys. Without it, enquiries are still saved but no email is sent.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend (use onboarding@resend.dev only for testing)
RESEND_FROM_EMAIL=enquiries@your-domain.in
RESEND_FROM_NAME=Poonam Beauty Academy

# Where new-enquiry emails go (comma-separated). Can also be set in Admin → Site Settings → Notifications.
ENQUIRY_NOTIFY_EMAIL=
